AI_PROVIDER=groq
GROQ_API_KEY=your_api_key_here
LOG_LEVEL=INFO
GROQ_MODEL=openai/gpt-oss-120b

# ──────────────────────────────────────────────
# Stage 5 — Voice Interface
# ──────────────────────────────────────────────

# Enable voice mode (start with: python -m backend.main --voice)
VOICE_ENABLED=false

# Wake phrase (case-insensitive fuzzy match)
WAKE_WORD=hello jarvis

# Seconds of silence before JARVIS stops recording your command
VOICE_SILENCE_TIMEOUT=1.2

# Maximum seconds to record a single command before giving up
VOICE_COMMAND_TIMEOUT=10

# Enable/disable individual subsystems
TTS_ENABLED=true
STT_ENABLED=true
