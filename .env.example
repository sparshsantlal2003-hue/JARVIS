# JARVIS configuration

# ==============================
# AI PROVIDER
# ==============================
AI_PROVIDER=omniroute

OMNIROUTE_API_KEY=your_omniroute_key
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Reasoning
OMNIROUTE_REASONING_MODEL=gpt-oss-120b
OMNIROUTE_REASONING_FALLBACK=llama-3.1-8b-instant

# Vision
OMNIROUTE_VISION_MODEL=gemini-flash-lite-latest
OMNIROUTE_VISION_FALLBACK=gemini-1.5-flash

OMNIROUTE_TIMEOUT=60
OMNIROUTE_MAX_RETRIES=2

# Legacy direct keys (if AI_PROVIDER=groq or gemini)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b


# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Stage 6 Background Assistant Config
BACKGROUND_MODE=false
START_WITH_WINDOWS=false
TRAY_ENABLED=true

# Stage 7 - Vision
VISION_ENABLED=True
VISION_MIN_CONFIDENCE=0.80
VISION_MAX_RETRIES=2
VISION_MODEL=gemini-1.5-flash
